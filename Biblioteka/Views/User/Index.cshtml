@model IEnumerable<Biblioteka.Models.User>
@{
    ViewData["Title"] = "Zarządzanie Użytkownikami";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info mt-3">@((string)TempData["Message"]!)</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Imię i Nazwisko</th>
            <th>Email</th>
            <th>Rola</th>
            <th>Wypożyczone</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Imie @item.Nazwisko</td>
                <td>@item.email</td>
                <td>
                    <span class="badge @(item.Rola == "admin" ? "bg-danger" : item.Rola == "worker" ? "bg-warning text-dark" : "bg-primary")">
                        @item.Rola
                    </span>
                </td>
                <td>@item.iloscWypKsiazek</td>
                <td>
                    <div class="d-flex">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary me-2">Edytuj</a>
                        <form asp-action="Delete" method="post" asp-route-id="@item.Id">
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Czy na pewno chcesz usunąć użytkownika @item.email?');">
                                Usuń
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
